---
const year = new Date().getFullYear();

const feedUrl = new URL("rss.xml", Astro.site).toString();
const instagramUrl = `https://instagram.com/luisdavidgd`;
const gitHubUrl = `https://github.com/luisdavidgd`;
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-identity">
      <p class="footer-name">Luis David Gallo Dawson</p>
      <p class="footer-location">Lima, Peru</p>
    </div>

    <div class="footer-links">
      <a href={gitHubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/blog">Blog</a>
      <button type="button" data-copy={feedUrl} aria-label="Copy RSS link">RSS</button>
    </div>

    <div class="footer-credit">
      &copy; {year} Luis David Gallo Dawson
    </div>
  </div>
</footer>

<script is:inline>
  document.querySelector("button[data-copy]")?.addEventListener("click", function () {
    const url = this.getAttribute("data-copy");
    if (!url) return;
    navigator.clipboard?.writeText(url);
    const original = this.textContent;
    this.textContent = "Copied!";
    setTimeout(() => {
      this.textContent = original;
    }, 1500);
  });
</script>

<style>
  .site-footer {
    padding: 3rem 1rem;
    text-align: center;
    border-top: 1px solid var(--color-border);
  }

  .footer-container {
    max-width: 72rem;
    margin: 0 auto;
  }

  .footer-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .footer-location {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0.25rem 0 0 0;
  }

  .footer-links {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    font-size: 0.875rem;
  }

  .footer-links a,
  .footer-links button {
    color: var(--color-text-secondary);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    font-size: 0.875rem;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .footer-links a:hover,
  .footer-links button:hover {
    color: var(--color-accent);
  }

  .footer-credit {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
</style>
