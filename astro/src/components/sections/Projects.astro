---
import { projects } from "../../data/projects";

interface Props {
  title?: string;
  showFeatured?: boolean;
}

const { title, showFeatured = false } = Astro.props as Props;

const displayProjects = showFeatured
  ? projects.filter((p) => p.featured)
  : projects;
---

<section class="projects-section">
  <div class="projects-container">
    {title && <h2 class="projects-title">{title}</h2>}

    <div class="projects-grid">
      {
        displayProjects.map((p) => (
          <article class="project-card">
            <h3 class="project-name">{p.name}</h3>
            <p class="project-description">{p.description}</p>
            <div class="project-tech">
              {p.tech.map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>
            <div class="project-links">
              {p.url && (
                <a href={p.url} class="project-link" target={p.url.startsWith("http") ? "_blank" : "_self"}>
                  {p.url.startsWith("http") ? "Live" : "View"} →
                </a>
              )}
              {p.source && (
                <a href={p.source} class="project-link" target="_blank">
                  Source →
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects-section {
    width: 100%;
    padding: 2.5rem 0;
  }

  .projects-container {
    margin-left: auto;
    margin-right: auto;
    max-width: 72rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .projects-title {
    font-size: 1.875rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .projects-title {
      font-size: 2.25rem;
    }
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .project-card {
    padding: 1.5rem;
    background: var(--color-surface);
    border-radius: 0.75rem;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .project-card:hover {
    transform: translateY(-0.25rem);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }

  .project-name {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .project-description {
    margin: 0 0 0.75rem 0;
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tech-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    background: var(--color-bg);
    color: var(--color-text-muted);
    border-radius: 9999px;
    border: 1px solid var(--color-border);
  }

  .project-links {
    display: flex;
    gap: 1rem;
  }

  .project-link {
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .project-link:hover {
    text-decoration: underline;
  }
</style>
