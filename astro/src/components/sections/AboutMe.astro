---
const gitHubUrl = `https://github.com/luisdavidgd`;
const twitterUrl = `https://x.com/guihubie`;
---

<section class="about">
  <div class="about-container">
    <div class="about-avatar">
      <img src="/img/profile.jpg" alt="Luis David Gallo Dawson" />
    </div>

    <h1>Luis David Gallo Dawson</h1>
    <p class="about-location">Lima, Peru</p>

    <div class="about-bio">
      <p>
        Developer. I build things, learn in public, and occasionally write about it.
      </p>
      <p>
        Software development is something I enjoy as a hobby. This site is my personal
        corner of the internet — a place to publish things I build, things I learn,
        experiments, technical notes, and ideas.
      </p>
    </div>

    <div class="about-links">
      <h2>Where to find me</h2>
      <div class="links">
        <a href={gitHubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={twitterUrl} target="_blank" rel="noopener noreferrer">X / Twitter</a>
        <a href="/rss.xml">RSS</a>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 6rem 1rem 3rem;
    text-align: center;
  }

  .about-container {
    max-width: 36rem;
    margin: 0 auto;
  }

  .about-avatar {
    margin-bottom: 1.5rem;
  }

  .about-avatar img {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .about-location {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .about-bio {
    text-align: left;
    margin-bottom: 3rem;
  }

  .about-bio p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .about-links h2 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }

  .links a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .links a:hover {
    text-decoration: underline;
  }
</style>
